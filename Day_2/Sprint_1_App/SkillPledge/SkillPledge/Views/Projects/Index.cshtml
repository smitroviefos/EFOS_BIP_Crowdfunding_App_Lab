@model IEnumerable<Project>
@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="mb-1">Projects looking for skills</h1>
        <p class="text-muted mb-0">Back a project with your knowledge – not with money.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No projects yet. Be the first to post one!</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var project in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm project-card">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@project.Title</h5>
                            <partial name="_StatusBadge" model="project.Status" />
                        </div>
                        <p class="card-text text-muted small mb-2">
                            by @(project.Owner?.UserName ?? "unknown") · deadline @project.Deadline.ToString("d MMM yyyy")
                        </p>
                        <p class="card-text">@project.Description</p>

                        <div class="mt-auto">
                            <p class="small fw-semibold mb-1">Skills needed</p>
                            <div class="mb-3">
                                @foreach (var skill in project.SkillsNeeded.OrderBy(s => s.Name))
                                {
                                    <span class="skill-chip">@skill.Name</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-muted">@project.Pledges.Count pledge(s)</span>
                                <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-sm btn-primary">View project</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
