@model DashboardViewModel
@{
    ViewData["Title"] = "My SkillPledge";
}

<h1 class="mb-1">My SkillPledge</h1>
<p class="text-muted">Hello @Model.UserName – here are your projects and the knowledge you offered.</p>

<div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
    <div class="col"><div class="stat-tile"><div class="stat-value">@Model.MyProjects.Count</div><div class="stat-label">my projects</div></div></div>
    <div class="col"><div class="stat-tile"><div class="stat-value">@Model.HoursReceived</div><div class="stat-label">hours received</div></div></div>
    <div class="col"><div class="stat-tile"><div class="stat-value">@Model.MyPledges.Count</div><div class="stat-label">my pledges</div></div></div>
    <div class="col"><div class="stat-tile"><div class="stat-value">@Model.HoursPledged</div><div class="stat-label">hours I pledged</div></div></div>
</div>

<div class="d-flex justify-content-between align-items-end mb-2">
    <h3 class="mb-0">My projects</h3>
    <a asp-controller="Projects" asp-action="Create" class="btn btn-sm btn-primary">+ Post a project</a>
</div>
@if (!Model.MyProjects.Any())
{
    <p class="text-muted">You have not posted a project yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>Project</th>
                <th>Status</th>
                <th>Deadline</th>
                <th style="min-width: 180px">Skills covered</th>
                <th class="text-end">Hours</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var project in Model.MyProjects)
            {
                <tr>
                    <td><a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id">@project.Title</a></td>
                    <td><partial name="_StatusBadge" model="project.Status" /></td>
                    <td>@project.Deadline.ToString("d MMM yyyy")<br /><partial name="_DeadlineInfo" model="project" /></td>
                    <td><partial name="_SkillsProgress" model="project" /></td>
                    <td class="text-end">@project.TotalHours()</td>
                    <td class="text-end text-nowrap">
                        <a asp-controller="Projects" asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h3 class="mt-4 mb-2">Knowledge I offered</h3>
@if (!Model.MyPledges.Any())
{
    <p class="text-muted">
        You have not pledged yet. <a asp-controller="Projects" asp-action="Index">Find a project</a> that needs your skills.
    </p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>Project</th>
                <th>Skill</th>
                <th class="text-end">Hours</th>
                <th>Message</th>
                <th>Date</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var pledge in Model.MyPledges)
            {
                <tr>
                    <td><a asp-controller="Projects" asp-action="Details" asp-route-id="@pledge.ProjectId">@pledge.Project?.Title</a></td>
                    <td><span class="skill-chip">@pledge.Skill?.Name</span></td>
                    <td class="text-end">@pledge.Hours</td>
                    <td>@pledge.Message</td>
                    <td class="text-nowrap">@pledge.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                    <td class="text-end">
                        <form asp-controller="Pledges" asp-action="Withdraw" asp-route-id="@pledge.Id" asp-route-returnUrl="/Dashboard" method="post"
                              onsubmit="return confirm('Withdraw your pledge?');">
                            <button type="submit" class="btn btn-link btn-sm text-danger p-0">Withdraw</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
