@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero text-center py-5">
    <h1 class="display-5 fw-bold">Crowdfunding knowledge, not money</h1>
    <p class="lead col-lg-8 mx-auto">
        Post your project and list the skills it needs. Students from other fields back it
        by pledging their knowledge and time – marketing, design, coding, law, finance…
    </p>
    <a asp-controller="Projects" asp-action="Index" class="btn btn-primary btn-lg mt-2">Browse projects</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Projects" asp-action="Create" class="btn btn-outline-light btn-lg mt-2">Post a project</a>
    }
</section>

@* Sprint 3: live numbers from the database *@
<div class="row row-cols-2 row-cols-md-4 g-3 mt-3">
    <div class="col"><div class="stat-tile"><div class="stat-value">@Model.ProjectCount</div><div class="stat-label">projects posted</div></div></div>
    <div class="col"><div class="stat-tile"><div class="stat-value">@Model.OpenProjectCount</div><div class="stat-label">open right now</div></div></div>
    <div class="col"><div class="stat-tile"><div class="stat-value">@Model.PledgeCount</div><div class="stat-label">pledges of knowledge</div></div></div>
    <div class="col"><div class="stat-tile"><div class="stat-value">@Model.HoursPledged</div><div class="stat-label">hours pledged</div></div></div>
</div>

<div class="row text-center g-4 mt-4">
    <div class="col-md-4">
        <h5>1 · Post a project</h5>
        <p class="text-muted">Describe your idea and the skills you are missing.</p>
    </div>
    <div class="col-md-4">
        <h5>2 · Get pledges</h5>
        <p class="text-muted">Students offer a skill and a number of hours.</p>
    </div>
    <div class="col-md-4">
        <h5>3 · Learn together</h5>
        <p class="text-muted">Different study fields build real projects as one team.</p>
    </div>
</div>

@if (Model.LatestProjects.Any())
{
    <div class="d-flex justify-content-between align-items-end mt-4 mb-3">
        <h3 class="mb-0">Newest open projects</h3>
        <a asp-controller="Projects" asp-action="Index">See all →</a>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var project in Model.LatestProjects)
        {
            <div class="col">
                <div class="card h-100 shadow-sm project-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@project.Title</h5>
                        <partial name="_DeadlineInfo" model="project" />
                        <div class="my-2"><partial name="_SkillChips" model="project" /></div>
                        <div class="mt-auto">
                            <partial name="_SkillsProgress" model="project" />
                            <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="btn btn-sm btn-primary mt-3">View project</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
