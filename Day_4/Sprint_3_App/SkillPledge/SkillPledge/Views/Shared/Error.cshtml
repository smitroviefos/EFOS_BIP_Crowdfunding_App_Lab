@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h1 class="mb-3">Oops – something went wrong</h1>
    <p class="lead text-muted">An error occurred while processing your request. Please try again.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            If you report this bug, add this ID: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Back to the home page</a>
</div>
