@model ProjectFormViewModel
@{
    ViewData["Title"] = "Post a project";
}

<h1>Post a project</h1>
<p class="text-muted">Describe your idea and choose the skills you are missing.</p>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Create" method="post">
            <partial name="_ProjectForm" model="Model" />

            <button type="submit" class="btn btn-primary">Post project</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
