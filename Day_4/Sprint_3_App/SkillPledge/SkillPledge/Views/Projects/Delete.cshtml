@model Project
@{
    ViewData["Title"] = "Delete project";
}

<h1>Delete project</h1>

<div class="alert alert-warning mt-3">
    <p class="mb-1">Are you sure you want to delete <strong>@Model.Title</strong>?</p>
    @if (Model.Pledges.Any())
    {
        <p class="mb-0">Its <strong>@Model.Pledges.Count pledge(s)</strong> will be deleted too. This cannot be undone.</p>
    }
    else
    {
        <p class="mb-0">This cannot be undone.</p>
    }
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, delete it</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</form>
